digraph nfa {
  graph [rankdir=LR, bgcolor="transparent", nodesep=0.5, ranksep=0.7];
  "__start" [shape=none, label="", width=0, height=0];
  "q0" [id="s-q0", class="state accepting", shape=doublecircle, label="q0", tooltip="no part of aa matched"];
  "q1" [id="s-q1", class="state accepting", shape=doublecircle, label="q1", tooltip="the last symbol is a, the start of aa"];
  "__start" -> "q0" [id="start-edge"];
  "q0" -> "q0" [id="e-q0-q0", label="b"];
  "q0" -> "q1" [id="e-q0-q1", label="a"];
  "q1" -> "q0" [id="e-q1-q0", label="b"];
}
