digraph nfa {
  graph [rankdir=LR, bgcolor="transparent", nodesep=0.5, ranksep=0.7];
  "__start" [shape=none, label="", width=0, height=0];
  "q0" [id="s-q0", class="state accepting", shape=doublecircle, label="q0", tooltip="inside (ab)*: start"];
  "q1" [id="s-q1", class="state", shape=circle, label="q1", tooltip="inside a: end"];
  "q2" [id="s-q2", class="state accepting", shape=doublecircle, label="q2", tooltip="inside b: end"];
  "__start" -> "q0" [id="start-edge"];
  "q0" -> "q1" [id="e-q0-q1", label="a"];
  "q1" -> "q2" [id="e-q1-q2", label="b"];
  "q2" -> "q1" [id="e-q2-q1", label="a"];
}
