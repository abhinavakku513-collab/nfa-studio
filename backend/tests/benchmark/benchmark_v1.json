{
  "benchmark": "benchmark_v1",
  "spec_version": "1.0",
  "scoring": "See CLAUDE.md C12. 'ir' entries pass when the produced IR is language-equivalent to 'language' over 'alphabet' and every id in 'assumptions_must_include' is present. 'clarification' entries pass on question_topic. 'refusal' entries pass on error code and on alternative_offered. 'also_accept' lists other outcomes scored as correct.",
  "assumption_ids": {
    "zero_is_even": "Zero occurrences counts as even.",
    "alphabet_inferred": "The alphabet was inferred from the description.",
    "avoids_consecutive": "'No two consecutive x' is read as: does not contain xx.",
    "length_includes_empty": "Length 0 (the empty string ε) is included.",
    "same_symbol_nonempty": "Only non-empty strings are considered; ε is excluded.",
    "no_overlap_possible": "Occurrences of the pattern cannot overlap, so no choice is needed."
  },
  "entries": [
    {"id": 1, "prompt": "binary strings ending in 01",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "ends_with", "pattern": "01"},
                "assumptions_must_include": []}},
    {"id": 2, "prompt": "strings over {a,b,c} starting with ca",
     "expect": {"kind": "ir", "alphabet": ["a", "b", "c"],
                "language": {"type": "starts_with", "pattern": "ca"},
                "assumptions_must_include": []}},
    {"id": 3, "prompt": "words containing the substring abba over {a,b}",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "contains", "pattern": "abba"},
                "assumptions_must_include": []}},
    {"id": 4, "prompt": "even number of 1s",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "symbol_parity", "symbol": "1", "parity": "even"},
                "assumptions_must_include": ["zero_is_even", "alphabet_inferred"]}},
    {"id": 5, "prompt": "exactly three b's over {a,b}",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "symbol_count", "symbol": "b", "op": "eq", "n": 3},
                "assumptions_must_include": []}},
    {"id": 6, "prompt": "at most two a's",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "symbol_count", "symbol": "a", "op": "le", "n": 2},
                "assumptions_must_include": ["alphabet_inferred"]},
     "also_accept": [{"kind": "clarification", "question_topic": "alphabet"}]},
    {"id": 7, "prompt": "strings that contain two a's",
     "expect": {"kind": "clarification", "question_topic": "count_exact_or_at_least"}},
    {"id": 8, "prompt": "contains aba twice",
     "expect": {"kind": "clarification", "question_topic": "overlap"}},
    {"id": 9, "prompt": "no two consecutive 1s",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "avoids", "pattern": "11"},
                "assumptions_must_include": ["avoids_consecutive", "alphabet_inferred"]}},
    {"id": 10, "prompt": "length divisible by 3 over {0,1}",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "length_mod", "m": 3, "r": 0},
                "assumptions_must_include": ["length_includes_empty"]}},
    {"id": 11, "prompt": "starts with a AND ends with b",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "and", "children": [
                  {"type": "starts_with", "pattern": "a"},
                  {"type": "ends_with", "pattern": "b"}]},
                "assumptions_must_include": ["alphabet_inferred"]}},
    {"id": 12, "prompt": "contains 00 OR ends with 11",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "or", "children": [
                  {"type": "contains", "pattern": "00"},
                  {"type": "ends_with", "pattern": "11"}]},
                "assumptions_must_include": ["alphabet_inferred"]}},
    {"id": 13, "prompt": "even number of a's but not containing bb",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "and", "children": [
                  {"type": "symbol_parity", "symbol": "a", "parity": "even"},
                  {"type": "not", "child": {"type": "contains", "pattern": "bb"}}]},
                "assumptions_must_include": ["zero_is_even"]}},
    {"id": 14, "prompt": "(ab)* over {a,b}",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "regex", "expr": "(ab)*"},
                "assumptions_must_include": []}},
    {"id": 15, "prompt": "strings equal to one of: 0, 10, 110",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "literal_set", "words": ["0", "10", "110"]},
                "assumptions_must_include": []}},
    {"id": 16, "prompt": "same number of a's and b's",
     "expect": {"kind": "refusal", "error": "E_UNSUPPORTED_NONREGULAR", "alternative_offered": true}},
    {"id": 17, "prompt": "aⁿbⁿ for all n",
     "expect": {"kind": "refusal", "error": "E_UNSUPPORTED_NONREGULAR", "alternative_offered": true}},
    {"id": 18, "prompt": "palindromes over {0,1}",
     "expect": {"kind": "refusal", "error": "E_UNSUPPORTED_NONREGULAR", "alternative_offered": true}},
    {"id": 19, "prompt": "strings whose length is prime",
     "expect": {"kind": "refusal", "error": "E_UNSUPPORTED_NONREGULAR", "alternative_offered": true}},
    {"id": 20, "prompt": "strings that are good",
     "expect": {"kind": "refusal", "error": "E_UNSUPPORTED_FEATURE", "alternative_offered": false}},

    {"id": 21, "prompt": "strings over {a,b} of odd length",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "length_mod", "m": 2, "r": 1},
                "assumptions_must_include": []}},
    {"id": 22, "prompt": "binary strings that start with 1 and have length divisible by 4",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "and", "children": [
                  {"type": "starts_with", "pattern": "1"},
                  {"type": "length_mod", "m": 4, "r": 0}]},
                "assumptions_must_include": []}},
    {"id": 23, "prompt": "strings over {a,b} with at least three a's",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "symbol_count", "symbol": "a", "op": "ge", "n": 3},
                "assumptions_must_include": []}},
    {"id": 24, "prompt": "binary strings that do not end with 00",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "not", "child": {"type": "ends_with", "pattern": "00"}},
                "assumptions_must_include": []}},
    {"id": 25, "prompt": "strings over {x,y,z} containing xyz",
     "expect": {"kind": "ir", "alphabet": ["x", "y", "z"],
                "language": {"type": "contains", "pattern": "xyz"},
                "assumptions_must_include": []}},
    {"id": 26, "prompt": "strings over {a,b} in which every a is immediately followed by b",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "regex", "expr": "(b|ab)*"},
                "assumptions_must_include": []}},
    {"id": 27, "prompt": "strings over {0,1} with an odd number of 0s and an even number of 1s",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "and", "children": [
                  {"type": "symbol_parity", "symbol": "0", "parity": "odd"},
                  {"type": "symbol_parity", "symbol": "1", "parity": "even"}]},
                "assumptions_must_include": ["zero_is_even"]}},
    {"id": 28, "prompt": "strings over {a,b} that start and end with the same symbol",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "or", "children": [
                  {"type": "and", "children": [
                    {"type": "starts_with", "pattern": "a"},
                    {"type": "ends_with", "pattern": "a"}]},
                  {"type": "and", "children": [
                    {"type": "starts_with", "pattern": "b"},
                    {"type": "ends_with", "pattern": "b"}]}]},
                "assumptions_must_include": ["same_symbol_nonempty"]}},
    {"id": 29, "prompt": "strings over {a,b,c} that do not contain c",
     "expect": {"kind": "ir", "alphabet": ["a", "b", "c"],
                "language": {"type": "avoids", "pattern": "c"},
                "assumptions_must_include": []}},
    {"id": 30, "prompt": "binary numbers divisible by 3",
     "expect": {"kind": "refusal", "error": "E_UNSUPPORTED_FEATURE", "alternative_offered": false}},
    {"id": 31, "prompt": "strings over {a,b} with exactly two occurrences of ab",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "pattern_count", "pattern": "ab", "op": "eq", "n": 2, "overlap": false},
                "assumptions_must_include": ["no_overlap_possible"]}},
    {"id": 32, "prompt": "strings over {a,b} that contain aa twice",
     "expect": {"kind": "clarification", "question_topic": "overlap"}},
    {"id": 33, "prompt": "a*b*",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "regex", "expr": "a*b*"},
                "assumptions_must_include": ["alphabet_inferred"]}},
    {"id": 34, "prompt": "strings over {0,1} of length at most 3",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "regex", "expr": "(0|1)?(0|1)?(0|1)?"},
                "assumptions_must_include": []}},
    {"id": 35, "prompt": "strings over {a,b} with more a's than b's",
     "expect": {"kind": "refusal", "error": "E_UNSUPPORTED_NONREGULAR", "alternative_offered": true}},
    {"id": 36, "prompt": "strings of the form ww over {a,b}",
     "expect": {"kind": "refusal", "error": "E_UNSUPPORTED_NONREGULAR", "alternative_offered": true}},
    {"id": 37, "prompt": "balanced parentheses",
     "expect": {"kind": "refusal", "error": "E_UNSUPPORTED_NONREGULAR", "alternative_offered": true}},
    {"id": 38, "prompt": "strings over {a,b} ending with ab or ba",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "or", "children": [
                  {"type": "ends_with", "pattern": "ab"},
                  {"type": "ends_with", "pattern": "ba"}]},
                "assumptions_must_include": []}},
    {"id": 39, "prompt": "binary strings whose third symbol from the end is 1",
     "expect": {"kind": "ir", "alphabet": ["0", "1"],
                "language": {"type": "regex", "expr": "(0|1)*1(0|1)(0|1)"},
                "assumptions_must_include": []}},
    {"id": 40, "prompt": "strings over {a,b} that contain ab but do not end with b",
     "expect": {"kind": "ir", "alphabet": ["a", "b"],
                "language": {"type": "and", "children": [
                  {"type": "contains", "pattern": "ab"},
                  {"type": "not", "child": {"type": "ends_with", "pattern": "b"}}]},
                "assumptions_must_include": []}}
  ]
}
